# Stripe → Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: set either, both, or neither (neither = browser gong only)
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Sale size (in major units, e.g. dollars) that earns a louder gong
GONG_BIG_AT=100
GONG_HUGE_AT=1000

# Celebrate subscription renewals too? (true/false)
GONG_RENEWALS=true
# How much of the customer to show: full | masked | none
GONG_CUSTOMER=masked

# Node server only
PORT=8787
# If set, /gong and /events need ?token=...
GONG_TOKEN=

# MRR watcher (optional). Create a RESTRICTED key in Stripe with read-only access to Subscriptions only.
STRIPE_API_KEY=
# MRR goal in major units, shows "% left" in the app
MRR_GOAL=
MRR_POLL_MINUTES=15
