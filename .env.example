# Stripe → Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: set either, both, or neither (neither = browser gong only)
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Sale size (in major units, e.g. dollars) that earns a louder gong
GONG_BIG_AT=100
GONG_HUGE_AT=1000

# Celebrate subscription renewals too? (true/false)
GONG_RENEWALS=true
# How much of the customer to show: full | masked | none
GONG_CUSTOMER=masked

# Node server only
PORT=8787
# Where mrrgong-state.json and mrr-history.json live
GONG_DATA_DIR=.
# If set, /gong and /events need ?token=...
GONG_TOKEN=

# MRR watcher (optional). Create a RESTRICTED key in Stripe with read-only access to Subscriptions only.
STRIPE_API_KEY=
# MRR goal in major units, shows "% left" in the app
MRR_GOAL=
MRR_POLL_MINUTES=15

# Modes: calm | indie | broker
GONG_MODE=calm
GONG_MILESTONES=true
# Optional: tune the milestone ladders. Comma lists, or "none" to turn one off.
# GONG_SALE_MILESTONES=10,100,1000,10000
# GONG_MRR_MILESTONES=100,500,1000,5000,10000,25000,50000,100000
# Already have sales? Seed the lifetime count so the first one isn't "first sale ever".
# GONG_SALES_SO_FAR=
# Announce refunds and canceled subscriptions (private channels only)
GONG_SAD=false

# Phone push via ntfy (use a long random topic)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Public X posts (all four, or none). Milestones only unless X_POST_ALL_OVER is set.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_POST_ALL_OVER=

# Optional AI-written one-liners (never sees customer data)
ANTHROPIC_API_KEY=
GONG_AI_MODEL=claude-haiku-5-5
